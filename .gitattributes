# Текст — всегда LF, чтобы правильные ответы тестовых кадров не расходились на \r
* text=auto eol=lf

# Windows-скрипты — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.onnx binary
*.pt binary
